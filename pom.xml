<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.8</version>
    <relativePath/>
  </parent>
  <groupId>io.aurora</groupId>
  <artifactId>aurora-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Aurora Framework</name>
  <description>BaPiOS / Aurora — macOS-style, AI-native, permission-first admin framework</description>

  <modules>
    <module>aurora-contract</module>
    <module>aurora-rbac-core</module>
    <module>aurora-tool-registry</module>
    <module>aurora-agent-runtime</module>
    <module>aurora-retrieval</module>
    <module>aurora-app-demo</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <archunit.version>1.4.1</archunit.version>
    <minio.version>8.5.13</minio.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.aurora</groupId>
        <artifactId>aurora-contract</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.aurora</groupId>
        <artifactId>aurora-rbac-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.aurora</groupId>
        <artifactId>aurora-tool-registry</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.aurora</groupId>
        <artifactId>aurora-agent-runtime</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.aurora</groupId>
        <artifactId>aurora-retrieval</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>io.minio</groupId>
        <artifactId>minio</artifactId>
        <version>${minio.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
